{
	"schemaVersion": 1,
	"id": "shulkersorter",
	"version": "${version}",
	"name": "ShulkerSorter",
	"description": "Automatically sorts, merges and labels shulker boxes in your inventory by item category.",
	"authors": [
		"Dennis_thegamer"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/shulkersorter",
		"issues": "https://github.com/DennisTheGamer/ShulkerSorter/issues"
	},
	"license": "MIT",
	"icon": "assets/shulkersorter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.dennisthegamer.shulkersorter.fabric.ShulkerSorterFabric"
		],
		"client": [
			"de.dennisthegamer.shulkersorter.fabric.ShulkerSorterFabricClient"
		],
		"modmenu": [
			"de.dennisthegamer.shulkersorter.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"shulkersorter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.2-",
		"java": ">=25",
		"fabric-api": "*",
		"architectury": ">=21.0.2"
	},
	"suggests": {
		"modmenu": ">=20.0.0",
		"yet_another_config_lib": ">=3.9.4"
	}
}
