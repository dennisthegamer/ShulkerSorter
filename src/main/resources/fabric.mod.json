{
	"schemaVersion": 1,
	"id": "shulkersort",
	"version": "${version}",
	"name": "ShulkerSort",
	"description": "Automatically sorts, merges and labels shulker boxes in your inventory by item category.",
	"authors": [
		"DennisTheGamer"
	],
	"license": "MIT",
	"icon": "assets/shulkersort/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.dennisthegamer.shulkersort.ShulkerSort"
		],
		"client": [
			"de.dennisthegamer.shulkersort.ShulkerSortClient"
		],
		"modmenu": [
			"de.dennisthegamer.shulkersort.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"shulkersort.mixins.json",
		"shulkersort.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": ">=1.21 <=1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
