{
	"schemaVersion": 1,
	"id": "shulkersorter",
	"version": "${version}",
	"name": "ShulkerSorter",
	"description": "Automatically sorts, merges and labels shulker boxes in your inventory by item category.",
	"authors": [
		"DennisTheGamer"
	],
	"license": "MIT",
	"icon": "assets/shulkersorter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.dennisthegamer.shulkersorter.ShulkerSorter"
		],
		"client": [
			"de.dennisthegamer.shulkersorter.ShulkerSorterClient"
		],
		"modmenu": [
			"de.dennisthegamer.shulkersorter.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"shulkersorter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": ">=1.21 <=1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
