	"authors": [
		"DennisTheGamer"
	],
	"license": "MIT",
	"icon": "assets/shulkersorter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.dennisthegamer.shulkersorter.ShulkerSorter"
		],
		"client": [
			"de.dennisthegamer.shulkersorter.ShulkerSorterClient"
		],
		"modmenu": [
			"de.dennisthegamer.shulkersorter.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"shulkersorter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.2-",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": ">=20.0.0",
		"yet_another_config_lib": ">=3.9.4"
	}
